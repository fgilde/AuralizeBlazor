<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Hot reload (BrowserRefresh middleware) fails with HTTP 500 on precompressed html files outside the SPA fallback (wc/index.html). -->
    <CompressionExcludePatterns Condition="'$(Configuration)' == 'Debug'">wc/**/*.html</CompressionExcludePatterns>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Analyzers" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="MudBlazor.Extensions" Version="9.11.0" />
    <PackageReference Include="Nextended.CodeGen" Version="10.1.42" />
    
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AuralizeBlazor\AuralizeBlazor.csproj" />
  </ItemGroup>

  <!-- Nextended.CodeGen reads this config to generate the example sources
       (Examples\*.razor -> wwwroot\example-codes\*.md/*.html) at build time. -->
  <ItemGroup>
    <AdditionalFiles Include="CodeGen.config.json" />
  </ItemGroup>

  <!-- The Blazor SDK ignores a user supplied web.config on publish (CopyToPublishDirectory=Never),
       so copy it explicitly. Needed for the .md MIME mapping (example-codes/*.md) on IIS/Azure. -->
  <Target Name="CopyWebConfigToPublish" AfterTargets="Publish">
    <Copy SourceFiles="web.config" DestinationFiles="$(PublishDir)web.config" />
  </Target>

  <!-- Publishes the framework independent web component into wwwroot/wc (git ignored), so it is served at /wc/auralizer.js
       locally and in production, and the web component page can show it in a plain HTML page.
       Only republished when the web component or the library changed. -->
  <ItemGroup>
    <_WebComponentInputs Include="..\..\AuralizeBlazor\**\*.cs;..\..\AuralizeBlazor\**\*.razor;..\..\AuralizeBlazor\**\*.css;..\..\AuralizeBlazor\wwwroot\js\**\*.js;..\..\AuralizeBlazor\*.csproj;..\..\AuralizeBlazor.WebComponent\**\*"
                         Exclude="..\..\AuralizeBlazor*\bin\**;..\..\AuralizeBlazor*\obj\**" />
    <Content Remove="wwwroot\wc\**" />
  </ItemGroup>

  <Target Name="PublishWebComponent" BeforeTargets="ResolveProjectStaticWebAssets" Inputs="@(_WebComponentInputs)" Outputs="wwwroot\wc\auralizer.js">
    <PropertyGroup>
      <_WcPublishDir>$(BaseIntermediateOutputPath)wc-publish\</_WcPublishDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_WcPublishDir);wwwroot\wc" />
    <!-- Compression is done by this project for all its static assets. -->
    <Exec Command="dotnet publish &quot;..\..\AuralizeBlazor.WebComponent\AuralizeBlazor.WebComponent.csproj&quot; -c $(Configuration) -o &quot;$(_WcPublishDir.TrimEnd('\'))&quot; -p:CompressionEnabled=false" />
    <ItemGroup>
      <_WcFiles Include="$(_WcPublishDir)wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WcFiles)" DestinationFiles="@(_WcFiles->'wwwroot\wc\%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- Copied files keep their original date, mark the output as up to date for the incremental check. -->
    <Touch Files="wwwroot\wc\auralizer.js" />
  </Target>

  <Target Name="IncludeWebComponent" AfterTargets="PublishWebComponent" BeforeTargets="ResolveProjectStaticWebAssets">
    <ItemGroup>
      <Content Include="wwwroot\wc\**" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Remove="compilerconfig.json" />
    <Content Remove="wwwroot\Logo.png" />
    <Content Remove="wwwroot\web.config" />
  </ItemGroup>
  <ItemGroup>
    <_ContentIncludedByDefault Remove="wwwroot\web.config" />
  </ItemGroup>
  <ItemGroup>
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\profile.publishsettings" />
  </ItemGroup>
  <ItemGroup>
    <None Include="compilerconfig.json" />
    <None Include="wwwroot\Auralizer%27s Beat.mp3" />
    <None Include="wwwroot\Digital Serenade.mp3" />
    <None Include="wwwroot\Logo.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot\web.config" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Examples\AutoGradientsExample.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Update="Examples\CaptureConnectExample.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
