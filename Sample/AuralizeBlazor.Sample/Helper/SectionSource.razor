<div class="docs-section-source @Class">
    @if (!NoToolbar)
    {
        <MudToolBar DisableGutters="true" Dense="true">
            <MudTooltip Text="@TooltipSourceCodeText" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.Code" Size="Size.Small" Class="pa-3" OnClick="OnShowCode" />
            </MudTooltip>
            <MudTooltip Text="Copy code" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="pa-3" OnClick="CopyTextToClipboard" />
            </MudTooltip>
        </MudToolBar>
    }

    <MudExpansionPanel Class="mt-2" Style="border: 1px var(--mud-palette-primary) solid" Text="Code">
        <div class="docs-source-code @(ShowCode ? "docs-show-code" : "docs-hide-code")">
            @if (!string.IsNullOrEmpty(_sourceCode))
            {
                <MudExMarkdown Value="@_sourceCode" />
            }
        </div>
    </MudExpansionPanel>
</div>
